<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/x_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/dbk_widget_bg">
    <TextView android:id="@+id/x_check" style="@style/DbkWidgetCheck" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/x_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:text="Next habit" />
        <TextView android:id="@+id/x_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#9CA3AF" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
